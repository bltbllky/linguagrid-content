{
  "name": "linguagrid-content",
  "version": "1.0.0",
  "description": "LinguaGrid word data, pipeline and validation",
  "scripts": {
    "validate": "tsx scripts/cli/validate.ts",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include='scripts/**/*.ts' --test-coverage-exclude='scripts/**/*.test.ts' --test-coverage-exclude='scripts/fixtures/**' --test-coverage-exclude='scripts/cli/**' 'scripts/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build-site": "tsx scripts/cli/build-site.ts",
    "extract": "tsx scripts/cli/extract.ts",
    "export-review": "tsx scripts/cli/export-review.ts",
    "import-review": "tsx scripts/cli/import-review.ts",
    "import-roundtrip": "tsx scripts/cli/import-roundtrip.ts",
    "mt-check": "tsx scripts/cli/mt-check.ts",
    "b1-pool": "tsx scripts/cli/b1-pool.ts",
    "release": "tsx scripts/cli/build-release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bltbllky/linguagrid-content.git"
  },
  "bugs": {
    "url": "https://github.com/bltbllky/linguagrid-content/issues"
  },
  "homepage": "https://github.com/bltbllky/linguagrid-content#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "type": "module"
}
